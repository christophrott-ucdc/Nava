# Copiaza in .env si completeaza. Cheile sunt folosite DOAR de:
#   - scripts/tts-generate.mjs  (pre-genereaza vocile din assets/show/show.json)
#   - serverul din executabil, endpoint POST /api/tts (voce live optionala, cu cache pe disc)
# Fara chei, playerul functioneaza cu vocile pre-generate din assets/voice/, iar daca lipsesc
# si acestea, cade pe vocea browserului (Windows ro-RO speechSynthesis) cu lip-sync sintetic.

# ElevenLabs (recomandat: ofera timestamps per caracter -> lip-sync precis)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voci per personaj (ID-uri ElevenLabs). Daca lipsesc se folosesc vocile publice implicite din scripts/tts-generate.mjs
ELEVENLABS_VOICE_AVATAR_AI=
ELEVENLABS_VOICE_CAPITANUL=
ELEVENLABS_VOICE_LUMINA=
ELEVENLABS_VOICE_NATURA=
ELEVENLABS_VOICE_TEHNOLOGIC=

# Google Gemini TTS (alternativa; fara timestamps -> lip-sync estimat proportional)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Provider preferat pentru generare: elevenlabs | gemini
TTS_PROVIDER=elevenlabs
