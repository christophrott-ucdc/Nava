{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn TEHNOLOGICUL    R32\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Triumf juc\u259?u\u537?; apas\u259? pe \u8222?cinci m\u226?nere de lumin\u259?\u8221?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep A\u539?i \u238?nchis circuitele! Bateriile dau energie becurilor, iar felinarul echipajului lumineaz\u259?.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb160\sa80\keepn Varianta B \u8212? Exist\u259? contribu\u539?ii, dar activitatea nu este complet\u259? pentru to\u539?i\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn TEHNOLOGICUL    R33\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Practic \u537?i cald; \u8222?Felinarul vine cu voi\u8221? e promisiunea.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep R\u259?m\u226?n capetele atinse \u537?i firele legate de voi. M\u226?nerul de drum \u238?l pun eu. Felinarul vine cu voi.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb160\sa80\keepn Varianta C \u8212? Nu exist\u259? contribu\u539?ii la aceast\u259? activitate\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn TEHNOLOGICUL    R34\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [F\u259?r\u259? dram\u259?; \u8222?gata de plecare\u8221? spus vesel, simplu.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Firele au r\u259?mas pe mas\u259?. M\u226?nerul de drum \u238?l pun eu. Felinarul e gata de plecare.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R35\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Satisfac\u539?ie lini\u537?tit\u259?; \u8222?l\u226?ng\u259? mine\u8221? foarte aproape, cald.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Un felinar cu m\u226?ner de drum. Exact ce ne trebuia. \u206?l \u539?in aici, l\u226?ng\u259? mine.\par}
{\pard\plain\widctlpar\f1\fs28\b\sb280\sa150\keepn\outlinelevel0 Scena 6 Tunelul de stele\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Se prive\u537?te panorama. Nu exist\u259? o activitate de rezolvat pe tablete. Film: 388\u8211?504 s. Tunelul este un element de fic\u539?iune; nu este prezentat ca un mijloc de c\u259?l\u259?torie demonstrat \u537?tiin\u539?ific.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R36\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Autoritate bl\u226?nd\u259?; pauz\u259? \u238?nainte de \u8222?p\u226?n\u259? la cap\u259?t\u8221?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Intr\u259?m \u238?ntr-un tunel de stele. Tabletele se odihnesc acum. Felinarul vine cu noi p\u226?n\u259? la cap\u259?t.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn AVATARUL AI    R37\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Voce joas\u259?, de tunel; ofert\u259?, nu comand\u259?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Dup\u259? tunel \u238?ncepe drumul cunoscut. Pute\u539?i urm\u259?ri lumina sau doar stelele.\par}
{\pard\plain\widctlpar\f1\fs28\b\sb280\sa150\keepn\outlinelevel0 Scena 7 Saturn \u537?i drumul spre cas\u259?\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Saturn este vizibil \u238?n film. Moment de observa\u539?ie, apoi revenire spre P\u259?m\u226?nt. Film: 504\u8211?610 s.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R38\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [cald, clar, uimit f\u259?r\u259? strig\u259?te; pauze naturale]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Privi\u539?i inelele! E Saturn. Suntem din nou \u238?n Sistemul Solar. De aici, drumul spre cas\u259? ne este cunoscut.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn AVATARUL AI    R39\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [cald, clar, uimit f\u259?r\u259? strig\u259?te; pauze naturale]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep De departe, inelele par \u238?ntregi. De aproape, sunt nenum\u259?rate buc\u259?\u539?i de ghea\u539?\u259? \u537?i roc\u259?. Fiecare se rote\u537?te \u238?n jurul lui Saturn.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R40\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [cald, clar, uimit f\u259?r\u259? strig\u259?te; pauze naturale]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep L\u259?s\u259?m Saturn \u238?n urm\u259?. Urm\u259?toarea oprire este o lume cu oceane, nori \u537?i oameni care ne a\u537?teapt\u259?.\par}
{\pard\plain\widctlpar\f1\fs28\b\sb280\sa150\keepn\outlinelevel0 Scena 8 \u206?ntoarcerea pe P\u259?m\u226?nt\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [P\u259?m\u226?ntul reapare. C\u259?l\u259?toria filmat\u259? se \u238?ncheie la 678,05 s. Felinarul r\u259?m\u226?ne obiectul pove\u537?tii adus acas\u259?.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R41\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Uimire adev\u259?rat\u259? pe \u8222?P\u259?m\u226?ntul!\u8221?; apoi glas mai domol, cald.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep P\u259?m\u226?ntul! Uite ce albastru e. Pe aici era drumul nostru spre cas\u259?.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn AVATARUL AI    R42\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Aproape \u537?optit; accent pe \u8222?col\u539?ul nostru de nav\u259?\u8221?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Pun felinarul la fereastr\u259?. Nu lumineaz\u259? planeta, ci col\u539?ul nostru de nav\u259?.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R43\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Emo\u539?ie re\u539?inut\u259?; pauz\u259? \u238?nainte de \u8222?are unde s\u259? stea\u8221?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Am adus cu noi o lumin\u259? de departe. Acum are unde s\u259? stea.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn LUMINA    R44\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Ca o urare de r\u259?mas-bun; \u8222?valiza asta mic\u259?\u8221? foarte bl\u226?nd.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep C\u226?nd o s\u259? v\u259? aminti\u539?i de stele, poate v\u259? aminti\u539?i \u537?i de valiza asta mic\u259?.\par}
{\pard\plain\widctlpar\f1\fs28\b\sb280\sa150\keepn\outlinelevel0 Scena 9 Felinarul adus acas\u259?\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Epilogul \u238?ncepe dup\u259? film \u537?i dureaz\u259? \u238?n prezent 75 de secunde. Se arat\u259? contribu\u539?iile echipajului. La variante se alege o singur\u259? replic\u259?, potrivit \u238?ntregii c\u259?l\u259?torii.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn AVATARUL AI    R45\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [\u206?nchidere lin\u259?; enumerarea rostit\u259? f\u259?r\u259? grab\u259?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep C\u259?l\u259?toria s-a terminat. Pe ecran r\u259?m\u226?n felinarul \u537?i drumul prin cele trei lumi.\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Urm\u259?toarele trei replici sunt alternative. \u206?ntr-o reprezenta\u539?ie se roste\u537?te una singur\u259?, potrivit contribu\u539?iilor participan\u539?ilor.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb160\sa80\keepn Varianta A \u8212? To\u539?i participan\u539?ii activi au \u238?ncheiat activitatea\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [La aceast\u259? alegere se iau \u238?n calcul \u238?mpreun\u259? toate cele trei activit\u259?\u539?i ale c\u259?l\u259?toriei.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R46\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [M\u226?ndria echipajului; apas\u259? pe \u8222?legate de voi\u8221?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Aici sunt buc\u259?\u539?ile g\u259?site, ferestrele montate \u537?i firele legate de voi. Acesta e felinarul echipajului.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb160\sa80\keepn Varianta B \u8212? Exist\u259? contribu\u539?ii, dar activitatea nu este complet\u259? pentru to\u539?i\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [La aceast\u259? alegere se iau \u238?n calcul \u238?mpreun\u259? toate cele trei activit\u259?\u539?i ale c\u259?l\u259?toriei.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R47\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Accent pe \u8222?atingerile voastre\u8221?; final cald, \u238?mp\u259?cat.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Aici se v\u259?d atingerile voastre \u537?i ce au ad\u259?ugat atelierele. Acesta e felinarul c\u259?l\u259?toriei noastre.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb160\sa80\keepn Varianta C \u8212? Nu exist\u259? contribu\u539?ii la aceast\u259? activitate\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [La aceast\u259? alegere se iau \u238?n calcul \u238?mpreun\u259? toate cele trei activit\u259?\u539?i ale c\u259?l\u259?toriei.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R48\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Senin; \u8222?\u238?l p\u259?str\u259?m ca amintire\u8221? spus rar, cu tandre\u539?e.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Acesta e felinarul primit pe drum. Are un cerc, o frunz\u259? \u537?i un m\u226?ner. \u206?l p\u259?str\u259?m ca amintire.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn AVATARUL AI    R49\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Permisiune bl\u226?nd\u259?; vocea coboar\u259? p\u226?n\u259? la \u8222?vorbi\u539?i \u238?ncet\u8221?.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep Nu mai e nimic de ap\u259?sat. Pute\u539?i privi felinarul sau pute\u539?i vorbi \u238?ncet cu vecinul.\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R50\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Mul\u539?umire sincer\u259?; \u8222?Bun venit acas\u259?!\u8221? deschis, luminos.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep \u206?nchid valiza \u537?i las felinarul la vedere. Mul\u539?umesc pentru c\u259?l\u259?torie, echipaj. Bun venit acas\u259?!\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn C\u258?PITANUL    R51\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Ordin practic, prietenos; ritm rar, ca la final de zbor.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep R\u259?m\u226?ne\u539?i la posturi. Ghidul din sal\u259? v\u259? spune c\u226?nd v\u259? ridica\u539?i \u537?i pe unde mergem.\par}
{\pard\plain\widctlpar\f1\fs28\b\sb280\sa150\keepn\outlinelevel0 Scena 10 Ultima lumin\u259? a echipajului\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [\u206?n experien\u539?a interactiv\u259?, alegerea final\u259? devine disponibil\u259? spre sf\u226?r\u537?itul epilogului. Replica naratorului de mai jos se declan\u537?eaz\u259? dup\u259? \u238?ncheierea epilogului. DEMO TV omite aceast\u259? scen\u259?.]\par}
{\pard\plain\widctlpar\f1\fs22\b\sb150\sa60\keepn NARATORUL    R52\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Invita\u539?ie la ultima contribu\u539?ie. Nu se gr\u259?be\u537?te publicul.]\par}
{\pard\plain\widctlpar\f0\fs24\li240\sa180\sl300\slmult1\keep C\u259?l\u259?toria r\u259?m\u226?ne \u238?n ce a\u539?i ales voi. Privi\u539?i ce a\u539?i construit \u238?mpreun\u259?. Alege\u539?i pe ecran ce lua\u539?i cu voi acas\u259?, apoi trimite\u539?i ultima lumin\u259?.\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Pe tablete apare \u238?ntrebarea \u8222?Ce dar duci acas\u259??\u8221?. Alegerile sunt \u8222?O lumin\u259?\u8221?, \u8222?Grij\u259? pentru ceilal\u539?i\u8221? \u537?i \u8222?Curaj de explorator\u8221?. Participantul alege, apoi apas\u259? \u8222?Trimite simbolul meu\u8221?. Poate \u537?i s\u259? priveasc\u259?. Acestea sunt texte afi\u537?ate, nu replici \u238?nregistrate.]\par}
{\pard\plain\widctlpar\f0\fs22\i\sa110\sl270\slmult1\keepn [Contribu\u539?iile ajung pe ecranul central. Ghidul \u238?ncheie \u238?nt\u226?lnirea \u537?i conduce ie\u537?irea. Replicile ghidului, reac\u539?iile publicului \u537?i eventualele saluturi de final pot fi scrise aici de autor.]\par}
