# runtime
runs/
logs/
*.log
.env
.env.*
!.env.example
config.json
!config.example.json

# voice cache produced at runtime (pre-generated voices under assets/voice ARE committed)
cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# continuity heartbeat (scripts/heartbeat.ps1) + unit test bundles
HEARTBEAT.log
.tmp-tests/
data/users.json
data/sessions.json
