# dependencies / build output
node_modules/
dist/
dist-app/
*.tsbuildinfo

# media (too large for git) - see docs/HANDOFF.md for how to regenerate
media/*.mp4
media/*.mkv
media/*.mov
media/*.log
media/analysis/*.png
!media/analysis/.gitkeep

# runtime
runs/
logs/
*.log
.env
.env.*
!.env.example
config.json
config.wall.local.json
config.auto.local.json
config.wall.local.json.*.tmp
!config.example.json

# voice cache produced at runtime (pre-generated voices under assets/voice ARE committed)
cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# continuity heartbeat (scripts/heartbeat.ps1) + unit test bundles
HEARTBEAT.log
.tmp-tests/
data/users.json
data/sessions.json
data/nava.sqlite*
data/diagnostics/
data/installations/
.venv-optical/

# Audio production intermediates: WAV masters, QA renders and raw API responses stay local (runtime uses the MP3s in assets/music/)
assets/music/masters/
assets/music/qa/
*.api-pcm
data/audit*.jsonl

# AI-authored process documentation and retired development files: kept on disk, out of git
AI/
Old/
