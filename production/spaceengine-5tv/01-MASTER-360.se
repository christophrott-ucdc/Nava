// ============================================================================
// A PATRA LUME - SMOOTH APPROACH / MANN FINAL CUT
// SpaceEngine 0.991
// CAMERA = SHIP. Continuous cockpit experience.
//
// FINAL ROUTE:
//   EARTH
//   -> SIWARHA                    = LUMEA I / PLANETA LUMINII
//   -> KEPLER-186 d               = LUMEA II / PLANETA NATURII
//   -> MANN                       = LUMEA III / PLANETA ORASULUI / INVATATURII
//   -> GARGANTUA                  = reveal seen from Mann
//   -> GARGANTUA WORMHOLE
//   -> SATURN
//   -> EARTH                      = LUMEA IV / CASA
//
// DIRECTOR RULES:
// - no black transitions
// - no teleport between story beats
// - destination remains on the forward cockpit axis during travel
// - every major arrival uses TWO continuous approach stages:
//      1) interstellar braking to a distant visible approach point
//      2) slow final approach while the world grows in the windshield
// - final approach dialogue overlaps motion (no stop-and-talk arrival)
// - orbital exit and ship turn overlap, so departures do not feel parked
// - fixed 50 degree cockpit lens; no artificial FOV zoom
// ============================================================================

UserMoveControl "disabled"
UserRotationControl "disabled"
UserTimeControl "disabled"
UserStereobaseControl "disabled"

Hide Orbits
Hide OrbitMarks
Hide Labels
Hide Markers
Hide Grids
Hide Constellations
Hide SelPointer

Date "2026.08.31 12:00:00"
StopTime
MoveMode 2
FOV 50
DisplayMode "Cylinder"
// -----------------------------------------------------------------------------
// EARTH DEPARTURE
// -----------------------------------------------------------------------------
Select "EARTH_DEPARTURE"
Goto { Time 0 }
Wait 0.5
PlaySplinePath "EARTH_DEPARTURE" { Time 40.0 }

Wait 10.0

Wait 7.0
Wait 23.0

// =============================================================================
// LUMEA I - SIWARHA / PLANETA LUMINII
// =============================================================================
Select "Siwarha"
Center { Time 7.0 }
Wait 7.0
Track

// PHASE A - long interstellar run. We brake early and stop far enough away
// that Siwarha is already established in the windshield before final approach.
Goto
{
    Time 34.0
    AccelTime 8.0
    DriftTime 6.0
    DecelTime 20.0
    AccelPower 1.10
    DecelPower 1.003
    DistRad 110.0
    Center false
}
Wait 34.0

// PHASE B - visible final approach. The target grows continuously on-screen.
Goto
{
    Time 22.0
    AccelTime 3.0
    DriftTime 4.0
    DecelTime 15.0
    AccelPower 1.05
    DecelPower 1.002
    DistRad 12.0
    Center false
}
Wait 7.0
Wait 3.0
Wait 12.0

// Orbital capture starts immediately as translational braking ends.
Untrack
Orbit
{
    AngularSpeed 0.032
    Axis (0.18, 0.965, 0.19)
    FadeTime 10.0
    Func "Sin"
}
Wait 6.0

Wait 14.0
Wait 4.0

Wait 19.0
Wait 9.0

Wait 5.0

// Departure is ONE motion: orbital velocity fades while the nose turns to Nature.
StopOrbit { FadeTime 8.0 Func "Sin" }
Select "Kepler-186 d"
Center { Time 8.0 }
Wait 8.0
Track

// =============================================================================
// LUMEA II - KEPLER-186 d / PLANETA NATURII
// =============================================================================
// PHASE A - brake at long range instead of diving straight to the planet.
Goto
{
    Time 32.0
    AccelTime 7.0
    DriftTime 5.0
    DecelTime 20.0
    AccelPower 1.09
    DecelPower 1.003
    DistRad 100.0
    Center false
}
Wait 32.0

// PHASE B - slow visual approach from ~100 radii to 6.5 radii.
Goto
{
    Time 24.0
    AccelTime 3.0
    DriftTime 4.0
    DecelTime 17.0
    AccelPower 1.045
    DecelPower 1.0018
    DistRad 6.5
    Center false
}
Wait 7.0
Wait 3.0
Wait 14.0

Untrack
Orbit
{
    AngularSpeed 0.036
    Axis (0.41, 0.80, 0.44)
    FadeTime 11.0
    Func "Sin"
}
Wait 6.0

Wait 19.0
Wait 4.0

Wait 14.0
Wait 12.0

// Again: do not park, stop, then rotate. Both happen together.
StopOrbit { FadeTime 9.0 Func "Sin" }
Select "Mann"
Center { Time 9.0 }
Wait 9.0
Track

// =============================================================================
// LUMEA III - MANN / PLANETA ORASULUI / PLANETA INVATATURII
// SYSTEM: GARGANTUA
// =============================================================================
// PHASE A - interstellar entry. Mann appears first as a distant world.
Goto
{
    Time 36.0
    AccelTime 8.0
    DriftTime 6.0
    DecelTime 22.0
    AccelPower 1.085
    DecelPower 1.0025
    DistRad 120.0
    Center false
}
Wait 36.0

// PHASE B - deliberate arrival. Mann now grows visibly instead of popping in.
Goto
{
    Time 26.0
    AccelTime 3.0
    DriftTime 4.0
    DecelTime 19.0
    AccelPower 1.04
    DecelPower 1.0015
    DistRad 7.0
    Center false
}
Wait 9.0
Wait 4.0
Wait 13.0

Untrack
Orbit
{
    AngularSpeed 0.024
    Axis (0.12, 0.985, 0.08)
    FadeTime 12.0
    Func "Sin"
}
Wait 7.0

Wait 15.0

// GARGANTUA REVEAL FROM MANN.
// While the Mann orbit eases away, the ship turns toward the black hole.
StopOrbit { FadeTime 8.0 Func "Sin" }
Select "Gargantua"
Center { Time 8.0 }
Wait 8.0
Track

Wait 19.0
Wait 12.0

Wait 5.0

Wait 10.0

// =============================================================================
// GARGANTUA -> GARGANTUA WORMHOLE
// =============================================================================
Untrack
Select "Gargantua Wormhole"
Center { Time 8.0 }
Wait 8.0
Track

// First let the mouth become a real object in the windshield.
Goto
{
    Time 20.0
    AccelTime 4.0
    DriftTime 4.0
    DecelTime 12.0
    AccelPower 1.07
    DecelPower 1.003
    DistRad 7.0
    Center false
}
Wait 5.0
Wait 11.0
Wait 4.0

// Final mouth approach: visible expansion, not a one-frame jump.
Goto
{
    Time 12.0
    AccelTime 2.0
    DriftTime 2.0
    DecelTime 8.0
    AccelPower 1.04
    DecelPower 1.002
    DistRad 1.01
    Center false
}
Wait 12.0

// Physically cross the wormhole. No fade, no scripted teleport.
Untrack
Fly
{
    Axis (0, 0, 1)
    Speed 0.00000001
    FadeTime 2.0
    Func "Sin"
}
Wait 6.0
StopFly { FadeTime 2.0 Func "Sin" }
Wait 2.0

// =============================================================================
// SATURN - HOME SYSTEM REVEAL
// =============================================================================
Select "Saturn"
Center { Time 5.0 }
Wait 5.0
Track

// Two-stage Saturn arrival as well, so the rings grow naturally.
Goto
{
    Time 12.0
    AccelTime 3.0
    DriftTime 2.0
    DecelTime 7.0
    AccelPower 1.06
    DecelPower 1.003
